{
  "info": {
    "name": "Destiny Travels API",
    "description": "Postman tests for the Destiny Travels API (Express.js + MongoDB + Mongoose).\nRun the folders in order, or use the Collection Runner: requests build on each other.\nRun `npm run seed` first for a clean database, or let request 02 insert the sample data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "destinationId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Challenge 01: Add Destinations",
      "item": [
        {
          "name": "01 - Add a single destination",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Response is JSON with success = true', function () {",
                  "  pm.expect(pm.response.json().success).to.eql(true);",
                  "});",
                  "// Remember the new document's _id for the ID-based requests that follow",
                  "pm.collectionVariables.set('destinationId', pm.response.json().data._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/destinations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "destinations"
              ]
            },
            "description": "Creates one destination and returns the saved document.\n\nMongoose: create()",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Kashmir Valley\",\n  \"location\": \"Jammu and Kashmir, India\",\n  \"category\": \"Hill Station\",\n  \"price\": 26000,\n  \"rating\": 4.8,\n  \"duration\": 5,\n  \"bestSeason\": \"April - October\",\n  \"description\": \"Dal Lake houseboats, Gulmarg meadows and snow-capped peaks.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
